# Auth key — https://login.tailscale.com/admin/settings/keys → Generate auth key
# Only used for the first login; prompted by install.sh.
TS_AUTHKEY=tskey-auth-your-key-here
# Machine name in the tailnet. install.sh defaults to $(hostname -s).
TS_HOSTNAME=your-hostname
# Subnets to advertise, comma-separated (e.g. 192.168.1.0/24). Empty = none.
# install.sh defaults to the host's LAN subnet and appends 0.0.0.0/0,::/0
# (= exit node) if you pick role A. Approve both in the admin console.
TS_ROUTES=
# Extra flags for "tailscale up" — only applied on the first login.
TS_EXTRA_ARGS=
# nftables or iptables — must match Docker's firewall backend.
# Detected by install.sh (Debian 12 / Bookworm: nftables).
TS_FIREWALL_MODE=

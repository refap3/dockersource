# URL wallabag is reached at — must match what browsers/apps use.
# Auto-filled by install.sh with http://<host-ip>:8085
WALLABAG_DOMAIN_NAME=http://your-host-ip:8085
# Symfony secret — generate with: openssl rand -hex 32
# Auto-generated by install.sh. Do not change after first start.
WALLABAG_SECRET=your-64-char-hex-secret-here
